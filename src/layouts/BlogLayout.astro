---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { SITE, SOCIAL } from '../consts';
import { article, breadcrumb, faqPage } from '../schema';

interface Toc {
  id: string;
  text: string;
}
interface RelatedPost {
  slug: string;
  title: string;
  category: string;
}
interface Props {
  title: string;
  description: string;
  heading: string;
  category: string;
  categorySlug: string;
  slug: string;
  published: string;
  modified: string;
  displayDate: string;
  readingTime: string;
  toc: Toc[];
  faqs: { q: string; a: string }[];
  speakable: string[];
  related: RelatedPost[];
  service?: { slug: string; name: string };
}

const {
  title, description, heading, category, categorySlug, slug,
  published, modified, displayDate, readingTime, toc, faqs, speakable, related,
  service,
} = Astro.props;

const path = `/blog/${slug}.html`;

// Each article points up to the guide for its topic, so the cluster links in
// both directions. Categories with no guide show nothing.
const HUB_FOR_CATEGORY: Record<string, { slug: string; name: string }> = {
  seo: { slug: 'seo', name: 'SEO' },
  'local-business': { slug: 'seo', name: 'SEO' },
  aeo: { slug: 'aeo', name: 'AEO' },
  geo: { slug: 'geo', name: 'GEO' },
};
const hub = HUB_FOR_CATEGORY[categorySlug];
const shareUrl = new URL(path, SITE.url).href;
---

<BaseLayout
  title={`${title} | ${SITE.name}`}
  description={description}
  path={path}
  ogType="article"
  jsonLd={[
    article({
      headline: title,
      description,
      url: path,
      datePublished: published,
      dateModified: modified,
      speakable,
    }),
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Blog', path: '/blog.html' },
      { name: title, path },
    ]),
    faqPage(faqs),
  ]}
>
  <article class="post">
    <header class="container narrow post-head">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Blog', href: '/blog.html' },
          { name: category, href: `/blog/category/${categorySlug}.html` },
        ]}
      />
      <p class="eyebrow">
        <a href={`/blog/category/${categorySlug}.html`}>{category}</a>
      </p>
      <h1>{heading}</h1>
      <p class="post-meta">
        <time datetime={published}>{displayDate}</time>
        <span aria-hidden="true">/</span>
        <span>{readingTime}</span>
        <span aria-hidden="true">/</span>
        <span>By <a href="/about.html">{SITE.name}</a></span>
      </p>
      {
        hub && (
          <p class="post-hub">
            Part of the <a href={`/guides/${hub.slug}.html`}>{hub.name} guide</a>. New
            to a term? See the <a href="/glossary.html">glossary</a>.
          </p>
        )
      }
    </header>

    <div class="container post-layout">
      {
        toc.length > 0 && (
          <aside class="post-toc" aria-labelledby="toc-heading">
            <details open>
              <summary id="toc-heading">Contents</summary>
              <ol>
                {toc.map((t) => (
                  <li>
                    <a href={`#${t.id}`}>{t.text}</a>
                  </li>
                ))}
              </ol>
            </details>
          </aside>
        )
      }

      <div class="prose">
        <slot />
      </div>
    </div>
  </article>

  {
    faqs.length > 0 && (
      <Faq
        items={faqs}
        heading="Frequently asked questions"
        headingId="frequently-asked-questions"
      />
    )
  }

  <section class="section-sm" aria-labelledby="author-heading">
    <div class="container narrow">
      <div class="card author">
        <span class="author-mark" aria-hidden="true">NP</span>
        <div>
          <h2 id="author-heading">{SITE.name}</h2>
          <p class="muted">
            {SITE.role} from {SITE.location}. I help businesses grow through SEO, AI
            automation, and modern web development, with {SITE.experienceYears} years of
            hands-on experience.
          </p>
          <p class="author-links">
            <a href={SOCIAL.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
            <a href="/contact.html">Contact</a>
            <a href="/about.html">About</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-sm" aria-labelledby="related-heading">
        <div class="container narrow">
          <h2 id="related-heading">Keep reading</h2>
          <div class="related-grid">
            {related.map((r) => (
              <a class="card related-card" href={`/blog/${r.slug}.html`}>
                <span class="related-tag">{r.category}</span>
                <span class="related-title">{r.title}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section-sm">
    <div class="container narrow">
      <div class="card post-cta">
        <h2>
          {service ? `Want ${service.name} done for your business?` : 'Want this done for your business?'}
        </h2>
        <p class="muted">
          Tell me what you are trying to grow and I will reply with a clear next step.
        </p>
        <div class="post-cta-actions">
          <a href="/contact.html" class="btn btn-primary">Start a project</a>
          {
            service ? (
              <a href={`/services/${service.slug}.html`} class="btn btn-ghost">
                {service.name} services
              </a>
            ) : (
              <a href="/services.html" class="btn btn-ghost">
                See all services
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .post-head {
    padding-top: var(--section-y-sm);
  }
  .post-head h1 {
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    margin: 0.6rem 0 1rem;
  }
  .eyebrow a:hover {
    color: var(--accent-hover);
  }
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .post-hub {
    margin-top: 0.9rem;
    font-size: 0.92rem;
    color: var(--text-muted);
  }
  .post-hub a {
    color: var(--link);
    font-weight: 600;
  }
  .post-meta span[aria-hidden] {
    color: var(--border-strong);
  }
  .post-meta a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* Body sits in the narrow measure; the table of contents rides alongside it
     on wide screens and collapses above the article on small ones. */
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, var(--container-narrow)) minmax(0, 260px);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
    padding-block: var(--section-y-sm);
  }
  .post-toc {
    position: sticky;
    top: 90px;
    order: 2;
    font-size: 0.9rem;
  }
  .post-toc summary {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
    margin-bottom: 0.8rem;
  }
  .post-toc ol {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    border-left: 1px solid var(--border);
    padding-left: 0.9rem;
  }
  .post-toc a {
    color: var(--text-muted);
  }
  .post-toc a:hover {
    color: var(--accent);
  }

  @media (max-width: 1000px) {
    .post-layout {
      grid-template-columns: 1fr;
    }
    .post-toc {
      position: static;
      order: 0;
      max-width: var(--container-narrow);
    }
  }

  /* Prose. The body is migrated HTML, so these rules target global elements. */
  .prose {
    max-width: var(--container-narrow);
  }
  .prose :global(p) {
    margin-bottom: 1.15rem;
  }
  .prose :global(.article-intro) {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    color: var(--text);
  }
  .prose :global(h2) {
    margin: 2.6rem 0 1rem;
    scroll-margin-top: 90px;
  }
  .prose :global(h3) {
    margin: 1.9rem 0 0.7rem;
    scroll-margin-top: 90px;
  }
  .prose :global(a) {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(a:hover) {
    color: var(--accent);
  }
  .prose :global(strong) {
    color: var(--text);
  }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.88em;
    background: var(--bg-elev-2);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose :global(.article-callout) {
    display: flex;
    gap: 1rem;
    background: var(--accent-soft);
    border: 1px solid var(--border-strong);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    padding: 1.2rem 1.4rem;
    margin: 2.2rem 0;
  }
  .prose :global(.article-callout p:last-child) {
    margin-bottom: 0;
  }
  .prose :global(.article-callout-icon) {
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .author {
    display: flex;
    gap: 1.3rem;
    align-items: flex-start;
  }
  .author h2 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .author-mark {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 12px;
    background: var(--accent);
    color: var(--accent-ink);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem;
    margin-top: 0.8rem;
    font-size: 0.9rem;
  }
  .author-links a {
    color: var(--link);
  }
  .author-links a:hover {
    color: var(--accent);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
    margin-top: 1.3rem;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .related-tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .related-title {
    font-family: var(--font-display);
    font-weight: 700;
    line-height: 1.25;
  }
  .related-card:hover .related-title {
    color: var(--accent);
  }

  .post-cta {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .post-cta .muted {
    max-width: 46ch;
  }
  .post-cta-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }
</style>
