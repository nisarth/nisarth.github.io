---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Faq from '../components/Faq.astro';
import { breadcrumb, faqPage } from '../schema';
import { SITE } from '../consts';
import { checklist, totalChecks } from '../data/seo-audit-checklist';

const path = '/seo-audit-checklist.html';
const title = `SEO Audit Checklist: ${totalChecks} Checks You Can Tick Off`;
const description = `A free SEO audit checklist with ${totalChecks} checks across crawling, on-page SEO, speed, structured data, AI answers, and local search. Tick them off and see your score.`;

const faqs = [
  {
    q: 'What is an SEO audit?',
    a: 'An SEO audit is a health check of a website. It looks at whether search engines can crawl and index the pages, whether each page matches a real search, how fast the site loads, and what is holding rankings back.',
  },
  {
    q: 'How often should I run an SEO audit?',
    a: 'A full audit once or twice a year is enough for most small sites. Run one again after a redesign, a move to a new platform, or a sudden drop in traffic. The tracking checks are worth a look every month.',
  },
  {
    q: 'Which tools do I need for this checklist?',
    a: 'Google Search Console and PageSpeed Insights cover most of it, and both are free. The Rich Results Test checks structured data. A crawler such as Screaming Frog helps on larger sites.',
  },
  {
    q: 'Is my score saved?',
    a: 'Your ticks are saved in your own browser only. Nothing is sent anywhere, and clearing your browser data removes them.',
  },
];

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'SEO audit checklist',
  numberOfItems: checklist.length,
  itemListElement: checklist.map((g, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: g.name,
    url: new URL(`${path}#${g.id}`, SITE.url).href,
  })),
};
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  jsonLd={[
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'SEO audit checklist', path }]),
    itemList,
    faqPage(faqs),
  ]}
>
  <section class="section">
    <div class="container narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'SEO audit checklist' }]} />
      <p class="eyebrow">Free tool</p>
      <h1>SEO audit checklist</h1>
      <p class="lead">
        An SEO audit checklist is a list of the things to check when a website is not
        getting the search traffic it should. This one has {totalChecks} checks in
        {checklist.length} groups. Tick what is already done and the score shows where
        to look next.
      </p>
      <p class="muted how">
        Work from the top. The groups are in order of importance, so a gap in the first
        group matters more than a gap in the last. This is a self-check, not a full
        audit: it tells you where to look, not everything that is wrong.
      </p>

      <nav class="jump" aria-label="Checklist groups">
        <ul>
          {
            checklist.map((g) => (
              <li>
                <a href={`#${g.id}`}>{g.name}</a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="container narrow" data-checklist>
      <div class="score" aria-live="polite">
        <div class="score-top">
          <p class="score-num">
            <strong data-score-done>0</strong>
            <span> of {totalChecks} done</span>
          </p>
          <button type="button" class="btn btn-ghost score-reset" data-reset hidden>Clear all</button>
        </div>
        <div class="bar" aria-hidden="true"><span data-score-bar></span></div>
        <p class="muted score-note" data-score-note>Tick the checks your site already passes.</p>
      </div>

      {
        checklist.map((g, gi) => (
          <section class="group" id={g.id} aria-labelledby={`${g.id}-heading`} data-group>
            <div class="group-head">
              <span class="group-num" aria-hidden="true">
                {String(gi + 1).padStart(2, '0')}
              </span>
              <h2 id={`${g.id}-heading`}>{g.name}</h2>
              <span class="group-count" data-group-count>
                0 / {g.checks.length}
              </span>
            </div>
            {g.note && <p class="group-note">{g.note}.</p>}
            <p class="muted">{g.intro}</p>
            <ul class="checks">
              {g.checks.map((c) => (
                <li>
                  <label>
                    <input type="checkbox" data-check={`${g.id}-${c.id}`} />
                    <span class="check-text">
                      <span class="check-label">{c.label}</span>
                      <span class="check-why">{c.why}</span>
                    </span>
                  </label>
                </li>
              ))}
            </ul>
          </section>
        ))
      }

      <div class="next card">
        <h2>Want this checked properly?</h2>
        <p class="muted">
          A checklist shows where to look. A full audit crawls every page, reads the Search
          Console data, and gives you the fixes in order. Read
          <a href="/blog/technical-seo-audit-checklist-2026.html">the longer technical audit guide</a>,
          or see <a href="/services/seo.html">how I do SEO</a>.
        </p>
        <a href="/contact.html" class="btn btn-primary">Ask for an audit</a>
      </div>
    </div>
  </section>

  <Faq items={faqs} />
</BaseLayout>

<script>
  const KEY = 'seo-audit-checklist-v1';
  const root = document.querySelector<HTMLElement>('[data-checklist]');

  if (root) {
    const boxes = Array.from(root.querySelectorAll<HTMLInputElement>('[data-check]'));
    const done = root.querySelector<HTMLElement>('[data-score-done]')!;
    const bar = root.querySelector<HTMLElement>('[data-score-bar]')!;
    const note = root.querySelector<HTMLElement>('[data-score-note]')!;
    const reset = root.querySelector<HTMLButtonElement>('[data-reset]')!;
    const groups = Array.from(root.querySelectorAll<HTMLElement>('[data-group]'));

    // Storage can be blocked or full. The checklist still works without it.
    const load = (): string[] => {
      try {
        return JSON.parse(localStorage.getItem(KEY) || '[]');
      } catch {
        return [];
      }
    };
    const save = () => {
      try {
        localStorage.setItem(
          KEY,
          JSON.stringify(boxes.filter((b) => b.checked).map((b) => b.dataset.check))
        );
      } catch {
        /* nothing to do */
      }
    };

    const message = (count: number, total: number) => {
      if (count === 0) return 'Tick the checks your site already passes.';
      const firstGap = groups.find((g) =>
        Array.from(g.querySelectorAll<HTMLInputElement>('[data-check]')).some((b) => !b.checked)
      );
      if (!firstGap) return 'Every check is ticked. Come back and re-check each month.';
      const name = firstGap.querySelector('h2')?.textContent ?? '';
      const share = count / total;
      const lead = share < 0.5 ? 'Plenty to fix.' : share < 0.8 ? 'A good base.' : 'Nearly there.';
      return `${lead} Next place to look: ${name}.`;
    };

    const render = () => {
      const count = boxes.filter((b) => b.checked).length;
      done.textContent = String(count);
      bar.style.setProperty('width', `${(count / boxes.length) * 100}%`);
      note.textContent = message(count, boxes.length);
      reset.hidden = count === 0;
      groups.forEach((g) => {
        const own = Array.from(g.querySelectorAll<HTMLInputElement>('[data-check]'));
        const ticked = own.filter((b) => b.checked).length;
        g.querySelector('[data-group-count]')!.textContent = `${ticked} / ${own.length}`;
        g.toggleAttribute('data-complete', ticked === own.length);
      });
    };

    const saved = new Set(load());
    boxes.forEach((b) => {
      b.checked = saved.has(b.dataset.check || '');
      b.addEventListener('change', () => {
        save();
        render();
      });
    });
    reset.addEventListener('click', () => {
      boxes.forEach((b) => (b.checked = false));
      save();
      render();
    });
    render();
  }
</script>

<style>
  h1 {
    margin-bottom: 1rem;
  }
  .how {
    margin-top: 1rem;
  }
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.6rem;
  }
  .jump a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.15s ease, border-color 0.15s ease;
  }
  .jump a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  /* The score stays in view while the list scrolls under it. */
  .score {
    position: sticky;
    top: 4.6rem;
    z-index: 5;
    margin-top: 2.2rem;
    padding: 1rem 1.2rem;
    background: var(--bg-elev);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: var(--shadow-md);
  }
  .score-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .score-num strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
    color: var(--accent);
  }
  .score-reset {
    padding: 0.4rem 0.9rem;
    font-size: 0.85rem;
  }
  .bar {
    height: 8px;
    margin: 0.6rem 0;
    border-radius: 4px;
    background: var(--border);
    overflow: hidden;
  }
  .bar span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: 4px;
    background: var(--accent);
    transition: width 0.35s ease;
  }
  .score-note {
    font-size: 0.9rem;
  }

  .group {
    margin-top: 3rem;
    /* Keeps a jumped-to heading clear of the header and the sticky score. */
    scroll-margin-top: 13rem;
  }
  .group-head {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.6rem;
  }
  .group-head h2 {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
  }
  .group-num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
  }
  .group-count {
    margin-left: auto;
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.15rem 0.6rem;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .group[data-complete] .group-count {
    color: var(--accent-ink);
    background: var(--accent);
    border-color: var(--accent);
  }
  .group-note {
    font-size: 0.85rem;
    font-style: italic;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }

  .checks {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    margin-top: 1.2rem;
  }
  .checks label {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
    padding: 0.9rem 1rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color 0.15s ease, background-color 0.15s ease;
  }
  .checks label:hover {
    border-color: var(--border-strong);
  }
  .checks input {
    flex-shrink: 0;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.2rem;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .check-text {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .check-label {
    font-weight: 600;
  }
  .check-why {
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .checks label:has(input:checked) {
    background: var(--accent-soft);
    border-color: var(--accent);
  }
  .checks label:has(input:checked) .check-label {
    text-decoration: line-through;
    text-decoration-color: var(--text-muted);
  }

  .next {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.9rem;
  }
  .next h2 {
    font-size: 1.5rem;
  }

  @media (max-width: 600px) {
    .score {
      top: 4rem;
    }
  }
</style>
