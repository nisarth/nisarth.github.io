---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import categories from '../data/blog-categories.json';
import { breadcrumb, blogIndex } from '../schema';

const title = 'Blog: SEO, AI Automation & Digital Growth | Nisarth Patel';
const description =
  'Practical articles on SEO, AI automation, GEO, web development, and digital marketing from Nisarth Patel, a digital growth specialist in Ahmedabad, India.';

const posts = (await getCollection('blog')).sort((a, b) => {
  const diff = b.data.published.getTime() - a.data.published.getTime();
  return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
});

const countOf = (slug: string) =>
  posts.filter((p) => p.data.categorySlug === slug).length;
---

<BaseLayout
  title={title}
  description={description}
  path="/blog.html"
  jsonLd={[
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog.html' }]),
    blogIndex(posts.map((p) => ({ name: p.data.title, url: `/blog/${p.id}.html` }))),
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Blog' }]} />
      <p class="eyebrow">Blog</p>
      <h1>The Blog</h1>
      <p class="lead blog-lead">
        Practical writing on SEO, answer engines, AI automation, and building fast
        websites. {posts.length} articles, no fluff.
      </p>

      <div class="blog-tools">
        <label class="visually-hidden" for="blog-search">Search articles</label>
        <input
          id="blog-search"
          type="search"
          placeholder="Search articles"
          autocomplete="off"
        />
        <ul class="link-chips">
          {
            categories.map((c) => (
              <li>
                <a href={`/blog/category/${c.slug}.html`}>
                  {c.heading.replace(/ Articles$/, '')} ({countOf(c.slug)})
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="search-status" role="status" aria-live="polite"></p>

      <div class="post-grid">
        {posts.map((p) => <PostCard post={p} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement: filters the cards already in the page, so there is
  // no index file to fetch and the list works fine with JavaScript disabled.
  const input = document.getElementById('blog-search') as HTMLInputElement | null;
  const status = document.querySelector('.search-status');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.post-card'));

  if (input && cards.length) {
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const hit = !q || (card.dataset.search || '').includes(q);
        card.hidden = !hit;
        if (hit) shown++;
      }
      if (status) {
        status.textContent = q
          ? `${shown} article${shown === 1 ? '' : 's'} match "${input.value.trim()}"`
          : '';
      }
    });
  }
</script>

<style>
  h1 {
    margin: 0.6rem 0 1rem;
  }
  .blog-lead {
    max-width: 56ch;
  }
  .blog-tools {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  #blog-search {
    max-width: 340px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    color: var(--text);
    padding: 0.65rem 0.9rem;
    font: inherit;
  }
  #blog-search:focus-visible {
    border-color: var(--accent);
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }
  .link-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .link-chips a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .link-chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .search-status {
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.3rem;
    margin-top: 2rem;
  }
</style>
