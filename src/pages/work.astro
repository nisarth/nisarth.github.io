---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Testimonials from '../components/Testimonials.astro';
import { getCollection } from 'astro:content';
import { breadcrumb, faqPage } from '../schema';
import Faq from '../components/Faq.astro';
import { SITE } from '../consts';
import { lastUpdated } from '../lib/last-updated';
import Numbers from '../components/Numbers.astro';
import { industries } from '../data/proof';

const title = 'Work: Case Studies in SEO, Automation, and Web';
const description =
  'Selected work by Nisarth Patel across SEO, AI automation, and web development. Detailed case studies with client results are being added.';

// Only confirmed case studies ship. Drafts stay out of the build entirely, so a
// half-written study can never appear here.
const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => {
  const at = a.data.finished?.getTime() ?? 0;
  const bt = b.data.finished?.getTime() ?? 0;
  return bt - at;
});

// The generic engagement cards are the fallback while there are no case
// studies. They describe the kind of work honestly and claim no numbers.
const engagements = [
  {
    tag: 'SEO',
    title: 'Organic search growth for a local business',
    goal: 'Goal: rank for the searches that bring real customers and grow steady organic leads.',
    work: 'Technical audit, on-page fixes, local SEO, and a content plan built around buyer intent.',
    steps: [
      'Audit the site for crawl, index, and speed problems',
      'Match each page to one search and fix titles, headings, and copy',
      'Set up and complete the Google Business Profile',
      'Plan content around the questions buyers ask',
      'Track rankings, clicks, and enquiries each month',
    ],
  },
  {
    tag: 'Automation',
    title: 'Lead and follow-up automation',
    goal: 'Goal: stop losing leads and free up hours of manual follow-up each week.',
    work: 'An n8n workflow linking the website form, CRM, email, and WhatsApp so follow-up happens on its own.',
    steps: [
      'Map the current manual steps from first enquiry to reply',
      'Pick the trigger and the tools that need to talk to each other',
      'Build the workflow and test it with real cases',
      'Add alerts for failed steps',
      'Write a short guide so it can be changed later',
    ],
  },
  {
    tag: 'Web',
    title: 'Fast, SEO-ready website build',
    goal: 'Goal: a site that loads fast, reads well on mobile, and is easy for search and AI tools to understand.',
    work: 'A static build with clean code, structured data, strong Core Web Vitals, and accessible design.',
    steps: [
      'Agree the pages, the content, and the URLs to keep',
      'Design mobile first, with accessible contrast and focus states',
      'Build static pages with structured data on each',
      'Redirect old URLs so rankings are not lost',
      'Test speed, forms, and a real phone before launch',
    ],
  },
  {
    tag: 'AEO and GEO',
    title: 'Getting cited by AI answer engines',
    goal: 'Goal: show up inside AI answers and featured snippets, not just the blue links.',
    work: 'Direct-answer content, FAQ schema, and pages structured the way AI retrieval reads them.',
    steps: [
      'List the questions buyers ask search engines and AI tools',
      'Check which answers already name the business, and which do not',
      'Rewrite key pages answer first, with clear headings',
      'Add FAQ, Article, and Organization schema',
      'Make business details match across the site and the web',
      'Re-test the same questions on a schedule',
    ],
  },
];

// Typed up front: a union of two differently shaped arrays leaves the
// optional url unnarrowable at the call site.
const listItems: { name: string; url?: string }[] = projects.length
  ? projects.map((p) => ({ name: p.data.title, url: `/work/${p.id}.html` }))
  : engagements.map((e) => ({ name: e.title }));

const itemList = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: projects.length ? 'Case studies by Nisarth Patel' : 'Types of work by Nisarth Patel',
  itemListElement: listItems.map((item, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: item.name,
    ...(item.url ? { url: new URL(item.url, SITE.url).href } : {}),
  })),
};

const faqs = [
  {
    q: 'Why are client names not shown?',
    a: 'Case studies on this page will describe the kind of business without naming it, so client details stay private.',
  },
  {
    q: 'Can I see results for a business like mine?',
    a: 'Yes. Tell me your industry and your goal, and I will walk you through the most relevant work on a call.',
  },
  {
    q: 'Do you only work with the industries listed here?',
    a: 'No. The list shows where I have worked so far. The method is the same in any field: find what holds the site back, fix it in order, and measure the result.',
  },
  {
    q: 'Where do the numbers on this page come from?',
    a: 'They combine my own work and work done with my team in my current full-time role, since January 2026. They are totals across client projects, not the result of one project.',
  },
];

const updated = lastUpdated('work');
---

<BaseLayout
  title={title}
  description={description}
  path="/work.html"
  jsonLd={[
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'Work', path: '/work.html' }]),
    itemList,
    faqPage(faqs),
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Work' }]} />
      <p class="eyebrow">Work</p>
      <h1>The work I do</h1>

      {
        projects.length > 0 ? (
          <>
            <p class="lead narrow-lead">
              Real projects, with the numbers that came out of them.
            </p>
            <div class="case-grid">
              {projects.map((p) => (
                <a class="card case-card" href={`/work/${p.id}.html`}>
                  <span class="case-client">{p.data.client}</span>
                  <h2>{p.data.title}</h2>
                  <p class="muted">{p.data.summary}</p>
                  {p.data.results.length > 0 && (
                    <ul class="case-results">
                      {p.data.results.slice(0, 2).map((r) => (
                        <li>
                          <strong>{r.change}</strong>
                          <span>{r.metric}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </a>
              ))}
            </div>
          </>
        ) : (
          <>
            <p class="lead narrow-lead">
              Here are the kinds of projects I take on. Detailed case studies with
              client results are being added. If you want specifics for a project like
              yours, just ask and I will walk you through real examples.
            </p>
            <div class="work-grid">
              {engagements.map((e) => (
                <article class="card work-item reveal">
                  <span class="work-tag">{e.tag}</span>
                  <h2>{e.title}</h2>
                  <p class="work-goal">{e.goal}</p>
                  <p class="muted">{e.work}</p>
                  <h3>What the work looks like</h3>
                  <ol class="work-steps">
                    {e.steps.map((s) => <li>{s}</li>)}
                  </ol>
                </article>
              ))}
            </div>
          </>
        )
      }

      <Numbers heading="Numbers so far" />

      <section class="industries" aria-labelledby="industries-heading">
        <h2 id="industries-heading">Industries I have worked with</h2>
        <p class="muted industries-lead">
          These are fields I have worked in. Each note says what usually matters most
          for search in that field.
        </p>
        <ul>
          {
            industries.map((ind) => (
              <li class="reveal">
                <h3>{ind.name}</h3>
                <p class="muted">{ind.note}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <div class="work-explain">
        <h2>How results are reported</h2>
        <p>
          A result only counts if you can check it. So every project starts by writing
          down where things stand: current rankings, clicks, and enquiries from Google
          Search Console and Google Analytics 4. That starting point is what later
          numbers are compared against.
        </p>
        <p>
          Case studies on this page will follow the same rule. Each one will say what
          the problem was, what was done, what changed, and over what period. Where a
          change cannot be tied clearly to the work, it will say so.
        </p>
      </div>

      <div class="work-cta card">
        <h2>Want the numbers?</h2>
        <p class="muted">
          I can share real results and references that match your industry and goals on
          a call.
        </p>
        <a href="/contact.html" class="btn btn-primary">Ask for case studies</a>
      </div>

      {updated && <p class="updated">Last updated: {updated}</p>}
    </div>
  </section>

  <Testimonials />

  <Faq heading="Questions about the work" items={faqs} />
</BaseLayout>

<style>
  .narrow-lead {
    max-width: 60ch;
    margin: 0.8rem 0 2rem;
  }
  .work-grid,
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
  }
  .work-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }
  .work-item h2,
  .case-card h2 {
    font-size: 1.35rem;
    margin-bottom: 0.6rem;
  }
  .work-goal {
    margin-bottom: 0.6rem;
  }
  .work-item h3 {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 1.3rem 0 0.7rem;
  }
  .work-steps {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    counter-reset: work-step;
  }
  .work-steps li {
    position: relative;
    padding-left: 1.9rem;
    counter-increment: work-step;
  }
  .work-steps li::before {
    content: counter(work-step);
    position: absolute;
    left: 0;
    top: 0.15rem;
    display: grid;
    place-items: center;
    width: 1.3rem;
    height: 1.3rem;
    border-radius: 50%;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent);
    background: var(--accent-soft);
  }
  .industries {
    margin-top: 3rem;
  }
  .industries-lead {
    max-width: 60ch;
    margin: 0.6rem 0 1.4rem;
  }
  .industries ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 0 2.2rem;
  }
  .industries li {
    padding: 1.1rem 0;
    border-top: 1px solid var(--border);
  }
  .industries h3 {
    font-size: 1.15rem;
    margin-bottom: 0.4rem;
  }
  .work-explain {
    margin-top: 3rem;
    max-width: 68ch;
  }
  .work-explain h2 {
    margin-bottom: 1rem;
  }
  .work-explain p + p {
    margin-top: 1rem;
  }

  .case-card {
    display: flex;
    flex-direction: column;
  }
  .case-client {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }
  .case-card:hover h2 {
    color: var(--accent);
  }
  .case-results {
    display: flex;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: auto;
    padding-top: 1.2rem;
  }
  .case-results li {
    display: flex;
    flex-direction: column;
  }
  .case-results strong {
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--text);
  }
  .case-results span {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  .work-cta {
    margin-top: 2rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }
  .work-cta .muted {
    max-width: 48ch;
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 2.5rem 0 0;
  }
</style>
