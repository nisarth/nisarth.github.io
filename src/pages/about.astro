---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { Picture } from 'astro:assets';
import portrait from '../assets/nisarth.jpg';
import { SITE } from '../consts';
import { person, breadcrumb, faqPage, personCareer } from '../schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { lastUpdated } from '../lib/last-updated';
import Experience from '../components/Experience.astro';
import { publishedRoles, publishedEducation, publishedCredentials } from '../data/experience';

const title = 'About Nisarth Patel: Freelance Digital Growth Specialist';
const description =
  'Nisarth Patel is a freelance digital growth specialist in Ahmedabad with 2.5 years helping businesses grow through SEO, AI automation, and web development.';

const skills = [
  { group: 'Search', items: ['Technical SEO', 'On-page SEO', 'Keyword strategy', 'AEO and GEO', 'Local SEO'] },
  { group: 'Automation', items: ['n8n', 'Make', 'Zapier', 'AI chatbots', 'Lead pipelines'] },
  { group: 'Web', items: ['Static sites', 'Core Web Vitals', 'Structured data', 'Accessibility'] },
  { group: 'Marketing', items: ['Content strategy', 'Email automation', 'Landing pages', 'Reporting'] },
];

// Working principles. To be confirmed by Nisarth: these describe an approach,
// not facts about his history.
const beliefs = [
  {
    title: 'Fix the base first',
    text: 'If search engines cannot crawl and read a site, nothing built on top of it will rank. Technical health comes before new content.',
  },
  {
    title: 'Write for people, structure for machines',
    text: 'The words should help a real buyer. The headings, schema, and links should make those words easy for search engines and AI tools to understand.',
  },
  {
    title: 'Answer the question',
    text: 'Search is moving from lists of links to direct answers. Pages that answer clearly in the first lines get quoted. Pages that circle around the point do not.',
  },
  {
    title: 'Measure what matters',
    text: 'A ranking is only useful if it brings the right visitors. Reports should link search visibility to enquiries, not stop at position numbers.',
  },
  {
    title: 'Say what is not known',
    text: 'Nobody outside Google knows the full ranking system, and measuring AI visibility is still rough. Honest limits are better than confident guesses.',
  },
];

const faqs = [
  {
    q: 'What does a digital growth specialist do?',
    a: 'A digital growth specialist helps a business get more customers online by improving how it shows up in search, AI answers, and on its own website. The work covers SEO, content, automation, and site performance.',
  },
  {
    q: 'Where are you based?',
    a: 'I am based in Ahmedabad, Gujarat, India, and I work remotely with clients across India and internationally.',
  },
  {
    q: 'How much experience do you have?',
    a: 'I have 2.5 years of hands-on experience across SEO, AI automation, and web development for startups, local businesses, and growing brands.',
  },
];
const updated = lastUpdated('about');
const career = personCareer({
  roles: publishedRoles,
  education: publishedEducation,
  credentials: publishedCredentials,
});
---

<BaseLayout
  title={title}
  description={description}
  path="/about.html"
  jsonLd={[person(career), breadcrumb([{ name: 'Home', path: '/' }, { name: 'About', path: '/about.html' }]), faqPage(faqs)]}
>
  <section class="section">
    <div class="container narrow">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'About' }]} />
      <p class="eyebrow">About</p>
      <h1>About {SITE.name}</h1>

      <div class="about-intro">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[240, 360, 480]}
          sizes="(max-width: 700px) 180px, 260px"
          alt={`${SITE.name}, freelance ${SITE.role.toLowerCase()} based in Ahmedabad`}
          loading="eager"
        />
        <p class="lead">
          {SITE.name} is a freelance {SITE.role.toLowerCase()} based in {SITE.location}.
          I help businesses get found online and turn that attention into leads, using
          SEO, answer engine optimization, and AI automation.
        </p>
      </div>

      <!-- Personal background to expand once confirmed with Nisarth:
           how he got started, past roles, education, notable clients. Kept
           general here so nothing is invented. -->
      <h2>How I work</h2>
      <p>
        I keep the work simple and honest. Every project starts with a clear goal,
        moves through steady and measurable steps, and ends with reporting you can
        actually read. No jargon, no vanity numbers, no lock-in.
      </p>
      <p>
        I care about the result that matters to your business, whether that is more
        organic traffic, more booked calls, or hours saved each week through
        automation.
      </p>

      <h2>What I believe about search</h2>
      <ul class="beliefs">
        {
          beliefs.map((b) => (
            <li class="reveal">
              <h3>{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>

      <h2>What I am good at</h2>
      <div class="skills-grid">
        {
          skills.map((s) => (
            <div class="card skill-card reveal">
              <h3>{s.group}</h3>
              <ul>
                {s.items.map((i) => <li>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>

      {updated && <p class="updated">Last updated: {updated}</p>}
      <a href="/contact.html" class="btn btn-primary">Work with me</a>
    </div>
  </section>

  <Experience />

  <Faq items={faqs} />
</BaseLayout>

<style>
  h2 {
    margin: 2.5rem 0 1rem;
  }
  .lead {
    margin-bottom: 1rem;
  }
  .about-intro {
    display: grid;
    grid-template-columns: 260px minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: center;
    margin-top: 1.5rem;
  }
  .about-intro :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-md);
  }
  .about-intro .lead {
    margin-bottom: 0;
  }
  @media (max-width: 700px) {
    .about-intro {
      grid-template-columns: 1fr;
      justify-items: start;
    }
    .about-intro :global(img) {
      max-width: 180px;
    }
  }
  .beliefs {
    display: flex;
    flex-direction: column;
  }
  .beliefs li {
    padding: 1.2rem 0;
    border-top: 1px solid var(--border);
  }
  .beliefs li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .beliefs h3 {
    font-size: 1.2rem;
    margin-bottom: 0.4rem;
  }
  .beliefs p {
    color: var(--text-muted);
  }
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.2rem;
    margin-top: 1.5rem;
  }
  .skill-card h3 {
    color: var(--accent);
    margin-bottom: 0.8rem;
  }
  .skill-card ul {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    color: var(--text-muted);
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 2.5rem 0 1.2rem;
  }
</style>
