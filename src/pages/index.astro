---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portrait from '../assets/nisarth.jpg';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { person, website } from '../schema';

const title = 'Nisarth Patel: Digital Growth Specialist (SEO & AI)';
const description =
  'Nisarth Patel is a freelance digital growth specialist in Ahmedabad who helps businesses get found through SEO, answer engine optimization, and AI automation.';

const services = [
  {
    name: 'SEO',
    line: 'SEO is the work of making a site rank in Google for the searches your buyers actually type.',
    detail: 'Technical audits, keyword strategy, on-page fixes, and content built to rank.',
  },
  {
    name: 'AEO and GEO',
    line: 'AEO and GEO are the work of getting your business quoted by AI answers and featured snippets.',
    detail: 'FAQ schema, direct-answer content, and pages structured for ChatGPT, Perplexity, and Google AI Overviews.',
  },
  {
    name: 'AI automation',
    line: 'AI automation is connecting your apps so repetitive work runs without you.',
    detail: 'n8n, Make, and Zapier workflows, AI chatbots, and lead pipelines that save hours each week.',
  },
  {
    name: 'Web development',
    line: 'Web development here means fast, SEO-ready sites that load in under a second.',
    detail: 'Static and modern builds, clean code, strong Core Web Vitals, and mobile-first design.',
  },
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => {
    const diff = b.data.published.getTime() - a.data.published.getTime();
    return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 3);

const workTeaser = [
  { tag: 'SEO', title: 'Organic search growth', text: 'Audits and content strategy that move a site up the rankings for the terms that bring real leads.' },
  { tag: 'Automation', title: 'Workflow automation', text: 'n8n and Make builds that link CRMs, email, and chat so follow-up happens on its own.' },
  { tag: 'Web', title: 'Website builds', text: 'Fast, accessible sites with structured data and clean URLs that search engines and AI tools can read.' },
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={[person(), website()]}>
  <!-- Hero -->
  <section class="hero section-lg">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{SITE.role} - {SITE.location}</p>
        <h1>I help businesses get found in search and AI answers.</h1>
        <p class="lead hero-lead">
          {SITE.name} is a freelance {SITE.role.toLowerCase()} in Ahmedabad. I use SEO,
          answer engine optimization, and AI automation to turn a quiet website into a
          steady source of leads.
        </p>
        <div class="hero-actions">
          <a href="/contact.html" class="btn btn-primary">Start a project</a>
          <a href="/work.html" class="btn btn-ghost">See the work</a>
        </div>
      </div>

      <div class="hero-portrait">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 260px, 420px"
          alt={`${SITE.name}, freelance ${SITE.role.toLowerCase()} based in Ahmedabad`}
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero-badge">
          <span class="dot" aria-hidden="true"></span>
          Available for new projects
        </p>
      </div>
    </div>

    <div class="container">
      <ul class="hero-stats">
        <li><strong>{SITE.experienceYears}+</strong><span>years in digital growth</span></li>
        <li><strong>SEO + AI</strong><span>search and automation focus</span></li>
        <li><strong>Remote</strong><span>India and worldwide</span></li>
      </ul>
    </div>
  </section>

  <!-- Services snapshot -->
  <section class="section services" aria-labelledby="services-heading">
    <div class="container">
      <p class="eyebrow">What I do</p>
      <h2 id="services-heading">Four ways I grow your business</h2>
      <div class="service-grid">
        {
          services.map((s) => (
            <article class="card service-card reveal">
              <h3>{s.name}</h3>
              <p class="service-line">{s.line}</p>
              <p class="muted">{s.detail}</p>
            </article>
          ))
        }
      </div>
      <a href="/services.html" class="btn btn-ghost">All services</a>
    </div>
  </section>

  <!-- Work teaser -->
  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-heading">The kind of problems I solve</h2>
      <div class="work-grid">
        {
          workTeaser.map((w) => (
            <article class="card work-card reveal">
              <span class="work-tag">{w.tag}</span>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </article>
          ))
        }
      </div>
      <a href="/work.html" class="btn btn-ghost">View case studies</a>
    </div>
  </section>

  <!-- About strip -->
  <section class="section about-strip" aria-labelledby="about-heading">
    <div class="container narrow reveal">
      <p class="eyebrow">About</p>
      <h2 id="about-heading">A freelancer who cares about results, not jargon</h2>
      <p class="lead">
        I have spent {SITE.experienceYears} years helping startups, local businesses,
        and growing brands show up where their customers look. I keep the work simple:
        clear plans, honest reporting, and steady progress you can measure.
      </p>
      <a href="/about.html" class="btn btn-ghost">More about me</a>
    </div>
  </section>

  <!-- Latest writing -->
  <section class="section" aria-labelledby="writing-heading">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h2 id="writing-heading">Latest from the blog</h2>
      <div class="post-teaser-grid">
        {
          latestPosts.map((p) => (
            <a class="card post-teaser reveal" href={`/blog/${p.id}.html`}>
              <span class="post-teaser-tag">{p.data.category}</span>
              <span class="post-teaser-title">{p.data.title}</span>
              <span class="muted post-teaser-meta">{p.data.readingTime}</span>
            </a>
          ))
        }
      </div>
      <a href="/blog.html" class="btn btn-ghost">Read the blog</a>
    </div>
  </section>

  <!-- CTA -->
  <section class="section cta-band">
    <div class="container cta-inner reveal">
      <h2>Have a project in mind?</h2>
      <p class="lead">Tell me what you are trying to grow. I will reply with a clear next step.</p>
      <a href="/contact.html" class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  /* Soft accent light plus a faint grid, both pure CSS so the hero gains
     depth without loading a single image. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 780px;
    z-index: -2;
    background:
      radial-gradient(46% 46% at 72% 22%, var(--accent-glow), transparent 68%),
      radial-gradient(40% 44% at 12% 8%, rgba(154, 208, 255, 0.09), transparent 70%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 68px 68px;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 0%, #000 10%, transparent 75%);
    mask-image: radial-gradient(70% 60% at 50% 0%, #000 10%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero h1 {
    max-width: 15ch;
    margin: 0.8rem 0 1.2rem;
  }
  .hero-lead {
    max-width: 52ch;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .hero-portrait {
    position: relative;
    justify-self: center;
    max-width: 420px;
    width: 100%;
  }
  .hero-portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.6);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-badge {
    position: absolute;
    left: 50%;
    bottom: -0.9rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-elev-2);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    box-shadow: var(--shadow-md);
    margin: 0;
  }
  .hero-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }
    .hero h1 {
      max-width: 18ch;
    }
    .hero-portrait {
      max-width: 300px;
      order: -1;
      justify-self: start;
    }
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
  }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
  }
  .hero-stats span {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .services h2,
  .work-grid + a,
  .service-grid + a {
    margin-bottom: 1.8rem;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .service-card h3 {
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .service-line {
    margin-bottom: 0.6rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .work-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }
  .work-card h3 {
    margin-bottom: 0.5rem;
  }

  .about-strip h2 {
    margin: 0.7rem 0 1rem;
  }
  .about-strip .btn {
    margin-top: 1.5rem;
  }

  .post-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .post-teaser {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-teaser-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .post-teaser-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .post-teaser:hover .post-teaser-title {
    color: var(--accent);
  }
  .post-teaser-meta {
    font-size: 0.85rem;
  }

  .cta-band {
    text-align: center;
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .cta-inner .lead {
    max-width: 46ch;
  }
</style>
