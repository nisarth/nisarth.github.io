---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Picture } from 'astro:assets';
import portrait from '../assets/nisarth.jpg';
import { getCollection } from 'astro:content';
import { SITE } from '../consts';
import { person, website, faqPage } from '../schema';
import SearchLab from '../components/SearchLab.astro';
import Marquee from '../components/Marquee.astro';
import Faq from '../components/Faq.astro';

// General explainers only. Nothing below is a claim about a client or a result.
const searchSteps = [
  {
    name: 'Crawl',
    text: 'Search engines send programs called crawlers to read your pages. If a page is blocked, slow, or not linked from anywhere, it may never be read. Technical SEO fixes this first.',
  },
  {
    name: 'Understand',
    text: 'The engine works out what each page is about and who is behind it. Clear headings, plain writing, and structured data make that meaning easy to read.',
  },
  {
    name: 'Rank',
    text: 'For each search, the engine picks the pages that answer it best and that people can trust. Useful content, links from other sites, and a fast page all count.',
  },
  {
    name: 'Answer',
    text: 'More and more, the engine writes the answer itself and names its sources. Google AI Overviews, ChatGPT, and Perplexity work this way. Pages that give short, direct answers are easier to quote.',
  },
];

const compare = {
  cols: [
    { name: 'SEO', href: '/services/seo.html' },
    { name: 'AEO', href: '/services/aeo.html' },
    { name: 'GEO', href: '/services/geo.html' },
  ],
  rows: [
    {
      label: 'Stands for',
      cells: ['Search engine optimization', 'Answer engine optimization', 'Generative engine optimization'],
    },
    {
      label: 'Where you show up',
      cells: [
        'Google and Bing results',
        'Featured snippets, People Also Ask, and voice answers',
        'ChatGPT, Perplexity, Gemini, and Google AI Overviews',
      ],
    },
    {
      label: 'What it needs',
      cells: [
        'Pages that can be crawled, the right keywords, useful content, and links',
        'Direct answers, question headings, and FAQ schema',
        'Clear facts about who you are, the same details across the web, and content that is easy to quote',
      ],
    },
    {
      label: 'How you know it works',
      cells: [
        'Rankings, clicks, and organic traffic',
        'Snippets won and questions you appear for',
        'Mentions and citations inside AI answers',
      ],
    },
  ],
};

const faqs = [
  {
    q: 'What is the difference between SEO, AEO, and GEO?',
    a: 'SEO helps your pages rank in search results. AEO shapes your content so search engines can lift it as a direct answer, such as a featured snippet. GEO helps AI tools like ChatGPT and Perplexity find, trust, and cite your business. They share the same base: a site that is easy to read and worth quoting.',
  },
  {
    q: 'How long does SEO take to show results?',
    a: 'Most sites see early movement in 2 to 3 months and stronger results by 6 months. Google itself says it usually takes four months to a year to see the full benefit of SEO work. Technical fixes can show sooner, and new content takes longer.',
  },
  {
    q: 'Do I still need SEO if people ask ChatGPT instead of Google?',
    a: 'Yes. AI tools build their answers from pages they can find and read. A site that is crawlable, clear, and trusted has a better chance of being used as a source, so the same basics still apply.',
  },
  {
    q: 'What is structured data?',
    a: 'Structured data, also called schema markup, is a small block of code that tells search engines what a page contains: a business, a service, an article, a list of questions. It helps them understand the page and can earn richer results.',
  },
  {
    q: 'What are Core Web Vitals?',
    a: 'Core Web Vitals are three Google measures of how a page feels to use: how fast the main content loads (LCP), how quickly the page reacts when you tap or click (INP), and how much the layout jumps while loading (CLS).',
  },
  {
    q: 'Can you promise a number one ranking?',
    a: 'No. Nobody can, and Google warns against anyone who does. What I can do is find what holds your site back, fix it in order of impact, and report progress in plain words.',
  },
];

// The places a business can show up. Shown one at a time in the hero.
const foundIn = ['Google Search', 'AI Overviews', 'ChatGPT', 'Perplexity', 'Google Maps'];

const marqueeItems = [
  'SEO',
  'AEO',
  'GEO',
  'Technical audits',
  'Structured data',
  'Core Web Vitals',
  'Websites',
  'Automation',
];

const title = 'Nisarth Patel: Digital Growth Specialist (SEO & AI)';
const description =
  'Nisarth Patel is a freelance digital growth specialist in Ahmedabad who helps businesses get found through SEO, answer engine optimization, and AI automation.';

const services = [
  {
    name: 'SEO',
    line: 'SEO is the work of making a site rank in Google for the searches your buyers actually type.',
    detail: 'Technical audits, keyword strategy, on-page fixes, and content built to rank.',
  },
  {
    name: 'AEO and GEO',
    line: 'AEO and GEO are the work of getting your business quoted by AI answers and featured snippets.',
    detail: 'FAQ schema, direct-answer content, and pages structured for ChatGPT, Perplexity, and Google AI Overviews.',
  },
  {
    name: 'AI automation',
    line: 'AI automation is connecting your apps so repetitive work runs without you.',
    detail: 'n8n, Make, and Zapier workflows, AI chatbots, and lead pipelines that save hours each week.',
  },
  {
    name: 'Web development',
    line: 'Web development here means fast, SEO-ready sites that load in under a second.',
    detail: 'Static and modern builds, clean code, strong Core Web Vitals, and mobile-first design.',
  },
];

const latestPosts = (await getCollection('blog'))
  .sort((a, b) => {
    const diff = b.data.published.getTime() - a.data.published.getTime();
    return diff !== 0 ? diff : a.data.title.localeCompare(b.data.title);
  })
  .slice(0, 3);

const workTeaser = [
  { tag: 'SEO', title: 'Organic search growth', text: 'Audits and content strategy that move a site up the rankings for the terms that bring real leads.' },
  { tag: 'Automation', title: 'Workflow automation', text: 'n8n and Make builds that link CRMs, email, and chat so follow-up happens on its own.' },
  { tag: 'Web', title: 'Website builds', text: 'Fast, accessible sites with structured data and clean URLs that search engines and AI tools can read.' },
];
---

<BaseLayout title={title} description={description} path="/" jsonLd={[person(), website(), faqPage(faqs)]}>
  <!-- Hero -->
  <section class="hero section-lg">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">{SITE.role} - {SITE.location}</p>
        <h1>I help businesses get found in search and AI answers.</h1>
        <p class="lead hero-lead">
          {SITE.name} is a freelance {SITE.role.toLowerCase()} in Ahmedabad. I use SEO,
          answer engine optimization, and AI automation to turn a quiet website into a
          steady source of leads.
        </p>
        <p class="found">
          <span class="found-label">Get found in</span>
          <span class="visually-hidden">{foundIn.join(', ')}</span>
          <span class="found-window" aria-hidden="true">
            <span class="found-reel">
              {foundIn.map((place) => <span>{place}</span>)}
              <span>{foundIn[0]}</span>
            </span>
          </span>
        </p>
        <div class="hero-actions">
          <a href="/contact.html" class="btn btn-primary">Start a project</a>
          <a href="/work.html" class="btn btn-ghost">See the work</a>
        </div>
      </div>

      <div class="hero-portrait">
        <Picture
          src={portrait}
          formats={['avif', 'webp']}
          fallbackFormat="jpeg"
          widths={[320, 480, 640]}
          sizes="(max-width: 900px) 260px, 420px"
          alt={`${SITE.name}, freelance ${SITE.role.toLowerCase()} based in Ahmedabad`}
          loading="eager"
          fetchpriority="high"
        />
        <p class="hero-badge">
          <span class="dot" aria-hidden="true"></span>
          Available for new projects
        </p>
      </div>
    </div>

    <div class="container">
      <ul class="hero-stats">
        <li><strong>{SITE.experienceYears}</strong><span>years in digital growth</span></li>
        <li><strong>SEO + AI</strong><span>search and automation focus</span></li>
        <li><strong>Remote</strong><span>India and worldwide</span></li>
      </ul>
    </div>
  </section>

  <Marquee items={marqueeItems} label="What I work on" />

  <!-- Animated drawings of the work -->
  <section class="section" aria-labelledby="lab-heading">
    <div class="container">
      <p class="eyebrow">How it works</p>
      <h2 id="lab-heading">Three places your customers look</h2>
      <p class="lead lab-lead">
        Pick one to see what the work changes. These are drawings, not client data.
      </p>
      <SearchLab />
    </div>
  </section>

  <!-- How search works -->
  <section class="section" aria-labelledby="steps-heading">
    <div class="container">
      <p class="eyebrow">The basics</p>
      <h2 id="steps-heading">How a search engine decides who shows up</h2>
      <p class="lead lab-lead">
        Every result you see went through the same four steps. My work is making each
        step easy for your site.
      </p>
      <ol class="steps">
        {
          searchSteps.map((step, i) => (
            <li class="step reveal">
              <span class="step-num" aria-hidden="true">0{i + 1}</span>
              <h3>{step.name}</h3>
              <p class="muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
      <div class="steps-actions">
        <a href="/seo-audit-checklist.html" class="btn btn-primary">Check your own site</a>
        <a href="/process.html" class="btn btn-ghost">See my process</a>
      </div>
    </div>
  </section>

  <!-- SEO, AEO, GEO compared -->
  <section class="section" aria-labelledby="compare-heading">
    <div class="container">
      <p class="eyebrow">Side by side</p>
      <h2 id="compare-heading">SEO, AEO, and GEO: what each one does</h2>
      <p class="lead lab-lead">
        Three names for one goal: being the business people find. Here is how they differ.
      </p>
      <div class="compare-wrap reveal" tabindex="0" role="region" aria-labelledby="compare-heading">
        <table class="compare">
          <thead>
            <tr>
              <td></td>
              {compare.cols.map((c) => (
                <th scope="col">
                  <a href={c.href}>{c.name}</a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              compare.rows.map((row) => (
                <tr>
                  <th scope="row">{row.label}</th>
                  {row.cells.map((cell) => <td>{cell}</td>)}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="steps-actions compare-actions">
        <a href="/guides/seo.html" class="btn btn-ghost">SEO guide</a>
        <a href="/guides/aeo.html" class="btn btn-ghost">AEO guide</a>
        <a href="/guides/geo.html" class="btn btn-ghost">GEO guide</a>
        <a href="/glossary.html" class="btn btn-ghost">Glossary</a>
      </div>
    </div>
  </section>

  <!-- Services snapshot -->
  <section class="section services" aria-labelledby="services-heading">
    <div class="container">
      <p class="eyebrow">What I do</p>
      <h2 id="services-heading">Four ways I grow your business</h2>
      <div class="service-grid">
        {
          services.map((s) => (
            <article class="card service-card reveal">
              <h3>{s.name}</h3>
              <p class="service-line">{s.line}</p>
              <p class="muted">{s.detail}</p>
            </article>
          ))
        }
      </div>
      <a href="/services.html" class="btn btn-ghost">All services</a>
    </div>
  </section>

  <!-- Work teaser -->
  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <p class="eyebrow">Selected work</p>
      <h2 id="work-heading">The kind of problems I solve</h2>
      <div class="work-grid">
        {
          workTeaser.map((w) => (
            <article class="card work-card reveal">
              <span class="work-tag">{w.tag}</span>
              <h3>{w.title}</h3>
              <p class="muted">{w.text}</p>
            </article>
          ))
        }
      </div>
      <a href="/work.html" class="btn btn-ghost">View case studies</a>
    </div>
  </section>

  <!-- About strip -->
  <section class="section about-strip" aria-labelledby="about-heading">
    <div class="container narrow reveal">
      <p class="eyebrow">About</p>
      <h2 id="about-heading">A freelancer who cares about results, not jargon</h2>
      <p class="lead">
        I have spent {SITE.experienceYears} years helping startups, local businesses,
        and growing brands show up where their customers look. I keep the work simple:
        clear plans, honest reporting, and steady progress you can measure.
      </p>
      <a href="/about.html" class="btn btn-ghost">More about me</a>
    </div>
  </section>

  <!-- Latest writing -->
  <section class="section" aria-labelledby="writing-heading">
    <div class="container">
      <p class="eyebrow">Writing</p>
      <h2 id="writing-heading">Latest from the blog</h2>
      <div class="post-teaser-grid">
        {
          latestPosts.map((p) => (
            <a class="card post-teaser reveal" href={`/blog/${p.id}.html`}>
              <span class="post-teaser-tag">{p.data.category}</span>
              <span class="post-teaser-title">{p.data.title}</span>
              <span class="muted post-teaser-meta">{p.data.readingTime}</span>
            </a>
          ))
        }
      </div>
      <a href="/blog.html" class="btn btn-ghost">Read the blog</a>
    </div>
  </section>

  <Faq heading="Common questions" items={faqs} />

  <!-- CTA -->
  <section class="section cta-band">
    <div class="container cta-inner reveal">
      <h2>Have a project in mind?</h2>
      <p class="lead">Tell me what you are trying to grow. I will reply with a clear next step.</p>
      <a href="/contact.html" class="btn btn-primary">Get in touch</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: clamp(2.5rem, 6vw, 4.5rem);
    overflow: hidden;
  }
  /* Soft accent light plus a faint grid, both pure CSS so the hero gains
     depth without loading a single image. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 780px;
    z-index: -2;
    background:
      radial-gradient(46% 46% at 72% 22%, var(--accent-glow), transparent 68%),
      radial-gradient(40% 44% at 12% 8%, var(--accent-soft), transparent 70%);
    pointer-events: none;
  }
  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 68px 68px;
    opacity: 0.4;
    -webkit-mask-image: radial-gradient(70% 60% at 50% 0%, #000 10%, transparent 75%);
    mask-image: radial-gradient(70% 60% at 50% 0%, #000 10%, transparent 75%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .hero h1 {
    max-width: 15ch;
    margin: 0.8rem 0 1.2rem;
  }
  .hero-lead {
    max-width: 52ch;
  }
  /* One place at a time, rolling upward. The reel repeats its first entry at
     the end so the jump back to the start cannot be seen. */
  .found {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.4rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.15rem, 2.2vw, 1.5rem);
    line-height: 1.5;
  }
  .found-label {
    color: var(--text-muted);
  }
  .found-window {
    display: inline-block;
    height: 1.5em;
    overflow: hidden;
    color: var(--accent);
  }
  .found-reel {
    display: flex;
    flex-direction: column;
    animation: found-roll 12s cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }
  .found-reel span {
    height: 1.5em;
    white-space: nowrap;
  }
  @keyframes found-roll {
    0%, 16% { transform: translateY(0); }
    20%, 36% { transform: translateY(-1.5em); }
    40%, 56% { transform: translateY(-3em); }
    60%, 76% { transform: translateY(-4.5em); }
    80%, 96% { transform: translateY(-6em); }
    100% { transform: translateY(-7.5em); }
  }
  @media (prefers-reduced-motion: reduce) {
    .found-reel {
      animation: none;
    }
  }

  .lab-lead {
    max-width: 56ch;
    margin-top: 0.8rem;
  }

  /* Four numbered steps joined by one rule, so they read as a sequence. */
  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: clamp(1.4rem, 3vw, 2.2rem);
    margin: 2.2rem 0;
    border-top: 1px solid var(--border-strong);
  }
  .step {
    position: relative;
    padding-top: 1.4rem;
  }
  .step::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
  .steps-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }
  .compare-actions {
    margin-top: 1.4rem;
  }
  .step-num {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }
  .step h3 {
    margin-bottom: 0.6rem;
  }

  /* The table scrolls sideways on narrow screens instead of squeezing. */
  .compare-wrap {
    margin-top: 2rem;
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
  }
  .compare {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    text-align: left;
  }
  .compare th,
  .compare td {
    padding: 1rem 1.2rem;
    vertical-align: top;
    border-bottom: 1px solid var(--border);
  }
  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }
  .compare thead th {
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .compare thead a {
    color: var(--accent);
  }
  .compare thead a:hover {
    text-decoration: underline;
  }
  .compare tbody th {
    width: 11rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .compare tbody td {
    color: var(--text);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.8rem;
  }

  .hero-portrait {
    position: relative;
    justify-self: center;
    max-width: 420px;
    width: 100%;
  }
  .hero-portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: calc(var(--radius) * 1.6);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-lg);
  }
  .hero-badge {
    position: absolute;
    left: 50%;
    bottom: -0.9rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    white-space: nowrap;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: var(--bg-elev-2);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    padding: 0.45rem 0.95rem;
    box-shadow: var(--shadow-md);
    margin: 0;
  }
  .hero-badge .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .hero-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: clamp(3rem, 6vw, 4.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.8rem;
    }
    .hero h1 {
      max-width: 18ch;
    }
    .hero-portrait {
      max-width: 300px;
      order: -1;
      justify-self: start;
    }
  }
  .hero-stats li {
    display: flex;
    flex-direction: column;
  }
  .hero-stats strong {
    font-family: var(--font-display);
    font-size: 1.7rem;
  }
  .hero-stats span {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .services h2,
  .work-grid + a,
  .service-grid + a {
    margin-bottom: 1.8rem;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .service-card h3 {
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .service-line {
    margin-bottom: 0.6rem;
  }

  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .work-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 0.7rem;
  }
  .work-card h3 {
    margin-bottom: 0.5rem;
  }

  .about-strip h2 {
    margin: 0.7rem 0 1rem;
  }
  .about-strip .btn {
    margin-top: 1.5rem;
  }

  .post-teaser-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.2rem;
    margin: 1.8rem 0;
  }
  .post-teaser {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .post-teaser-tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .post-teaser-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .post-teaser:hover .post-teaser-title {
    color: var(--accent);
  }
  .post-teaser-meta {
    font-size: 0.85rem;
  }

  .cta-band {
    text-align: center;
  }
  .cta-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
  }
  .cta-inner .lead {
    max-width: 46ch;
  }
</style>
