---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumb, person, personCareer } from '../schema';
import { SITE, SOCIAL } from '../consts';
import { publishedRoles, publishedEducation, publishedCredentials } from '../data/experience';
import { resumeSummary, resumeStatus, resumeSkills, resumeDownloads } from '../data/resume';

const path = '/resume.html';
const title = 'Resume: Nisarth Patel, SEO, AEO and GEO Specialist';
const description =
  'Resume of Nisarth Patel, an SEO specialist in Ahmedabad with 2.5 years of experience in technical SEO, AEO, and GEO. View it online or download the PDF.';

const monthYear = (value: string) => {
  const [year, month] = value.split('-');
  return new Date(Number(year), Number(month) - 1, 1).toLocaleString('en-GB', {
    month: 'short',
    year: 'numeric',
  });
};

const career = personCareer({
  roles: publishedRoles,
  education: publishedEducation,
  credentials: publishedCredentials,
});
const main = resumeDownloads.find((d) => d.primary)!;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  ogType="profile"
  jsonLd={[
    person(career),
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'Resume', path }]),
  ]}
>
  <article class="section resume">
    <div class="container narrow">
      <div class="screen-only">
        <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Resume' }]} />
      </div>

      <header class="head">
        <p class="eyebrow">Resume</p>
        <h1>{SITE.name}</h1>
        <p class="role">SEO Specialist: AEO, GEO and Technical SEO</p>
        <ul class="contact">
          <li>{SITE.location}</li>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={`tel:${SITE.tel}`}>{SITE.whatsappDisplay}</a></li>
          <li>
            <a href={SOCIAL.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
          </li>
        </ul>
        <div class="actions screen-only">
          <a class="btn btn-primary" href={main.href} download={main.file}>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 4v11m0 0-4-4m4 4 4-4M5 20h14" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            Download resume (PDF)
          </a>
          <button type="button" class="btn btn-ghost" data-print hidden>Print this page</button>
        </div>
      </header>

      <section aria-labelledby="summary-heading">
        <h2 id="summary-heading">Summary</h2>
        <p>{resumeSummary}</p>
        <p class="status">
          <span class="dot" aria-hidden="true"></span>
          {resumeStatus}
        </p>
      </section>

      <section aria-labelledby="skills-heading">
        <h2 id="skills-heading">Skills</h2>
        <dl class="skills">
          {
            resumeSkills.map((s) => (
              <div>
                <dt>{s.group}</dt>
                <dd>
                  <ul>
                    {s.items.map((item) => <li>{item}</li>)}
                  </ul>
                </dd>
              </div>
            ))
          }
        </dl>
      </section>

      <section aria-labelledby="experience-heading">
        <h2 id="experience-heading">Experience</h2>
        <ol class="roles">
          {
            publishedRoles.map((r) => (
              <li class="reveal">
                <div class="role-head">
                  <h3>{r.title}</h3>
                  <p class="period">
                    <time datetime={r.start}>{monthYear(r.start)}</time>
                    {' to '}
                    {r.end ? <time datetime={r.end}>{monthYear(r.end)}</time> : 'now'}
                  </p>
                </div>
                {r.employmentType && <p class="meta">{r.employmentType}</p>}
                <p>{r.summary}</p>
                {r.highlights && r.highlights.length > 0 && (
                  <ul class="highlights">
                    {r.highlights.map((h) => <li>{h}</li>)}
                  </ul>
                )}
              </li>
            ))
          }
        </ol>
      </section>

      <section aria-labelledby="education-heading">
        <h2 id="education-heading">Education and certificates</h2>
        <ul class="plain">
          {
            publishedEducation.map((e) => (
              <li>
                <strong>{e.qualification}</strong>
                <span class="muted">{e.institution}, {e.years.replace('-', ' to ')}</span>
              </li>
            ))
          }
          {
            publishedCredentials.map((c) => (
              <li>
                <strong>
                  {c.url ? (
                    <a href={c.url} rel="noopener noreferrer" target="_blank">{c.name}</a>
                  ) : (
                    c.name
                  )}
                </strong>
                <span class="muted">{c.issuer}, {c.year}</span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="screen-only" aria-labelledby="downloads-heading">
        <h2 id="downloads-heading">Downloads</h2>
        <ul class="downloads">
          {
            resumeDownloads.map((d) => (
              <li>
                <a class="card" href={d.href} download={d.file}>
                  <span class="dl-label">{d.label}</span>
                  <span class="muted">{d.note}</span>
                </a>
              </li>
            ))
          }
        </ul>
        <p class="muted more">
          Want the work behind the resume? See <a href="/work.html">the work page</a>,
          <a href="/services.html">services</a>, or <a href="/contact.html">get in touch</a>.
        </p>
      </section>
    </div>
  </article>
</BaseLayout>

<script>
  const print = document.querySelector<HTMLButtonElement>('[data-print]');
  if (print) {
    print.hidden = false;
    print.addEventListener('click', () => window.print());
  }
</script>

<style>
  .head {
    padding-bottom: 1.8rem;
    border-bottom: 1px solid var(--border-strong);
  }
  h1 {
    margin: 0.4rem 0 0.3rem;
  }
  .role {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.1rem, 2.2vw, 1.4rem);
    color: var(--accent);
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1.3rem;
    margin-top: 0.9rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .contact a,
  .plain a,
  .more a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.5rem;
  }

  section {
    margin-top: 2.4rem;
  }
  h2 {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1rem;
    font-weight: 600;
  }
  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  .skills {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .skills > div {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 0.5rem 1rem;
  }
  .skills dt {
    font-weight: 700;
  }
  .skills dd {
    margin: 0;
  }
  .skills ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skills li {
    font-size: 0.88rem;
    padding: 0.2rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
  }

  .roles {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    border-left: 2px solid var(--border);
    padding-left: 1.4rem;
  }
  .roles > li {
    position: relative;
  }
  .roles > li::before {
    content: '';
    position: absolute;
    left: calc(-1.4rem - 6px);
    top: 0.5rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent);
  }
  .role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.2rem 1rem;
  }
  .role-head h3 {
    font-size: 1.2rem;
  }
  .period {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--text-muted);
  }
  .meta {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
  }
  .highlights {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    margin-top: 0.6rem;
    color: var(--text-muted);
  }
  .highlights li {
    position: relative;
    padding-left: 1.3rem;
  }
  .highlights li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }

  .plain {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .plain li {
    display: flex;
    flex-direction: column;
  }

  .downloads {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 1rem;
  }
  .downloads a {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1.1rem 1.2rem;
  }
  .dl-label {
    font-weight: 700;
  }
  .downloads a:hover .dl-label {
    color: var(--accent);
  }
  .downloads .muted {
    font-size: 0.88rem;
  }
  .more {
    margin-top: 1.4rem;
  }

  @media (max-width: 600px) {
    .skills > div {
      grid-template-columns: 1fr;
    }
  }

  /* Printing gives a clean black on white resume with no site chrome. */
  @media print {
    .screen-only {
      display: none;
    }
    .resume {
      padding: 0;
    }
    .role,
    h2,
    .period {
      color: #000;
    }
    .roles > li {
      break-inside: avoid;
    }
  }
</style>

<style is:global>
  @media print {
    body:has(.resume) {
      background: #fff;
      color: #000;
    }
    body:has(.resume) :is(.site-header, .site-footer, .wa-fab, #consent, .skip-link) {
      display: none !important;
    }
    body:has(.resume) .reveal {
      animation: none;
      opacity: 1;
    }
  }
</style>
