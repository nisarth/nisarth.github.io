---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { breadcrumb, faqPage } from '../schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { lastUpdated } from '../lib/last-updated';

const title = 'My Process: How I Run a Digital Growth Project';
const description =
  'A clear six-step process from discovery to results. See how Nisarth Patel runs SEO, automation, and web projects with no surprises and no guesswork.';

const steps = [
  {
    n: '01',
    name: 'Discovery',
    line: 'Discovery is a short call to understand your business, your goals, and your customers.',
    detail: 'We talk about what you sell, who you sell to, and what a win looks like for you.',
    more: [
      'What you sell and who buys it',
      'Where your leads come from today',
      'What has been tried before, and what happened',
      'What a good result looks like, as a number where possible',
    ],
    output: 'You leave with a short written summary of the goal, so we both mean the same thing.',
  },
  {
    n: '02',
    name: 'Audit',
    line: 'An audit is a close look at where you stand today.',
    detail: 'I review your site, search rankings, content, and any tools you already use, then list what is holding you back.',
    more: [
      'Crawl health: can search engines reach and index the pages that matter',
      'On-page SEO: titles, headings, and how well each page matches a search',
      'Content quality, thin pages, and pages that compete with each other',
      'Internal links and site structure',
      'Core Web Vitals and page speed',
      'Structured data, and how the site shows up in AI answers',
    ],
    output: 'You get a list of what was found, in plain words, with the biggest problems first.',
  },
  {
    n: '03',
    name: 'Strategy',
    line: 'Strategy is a simple, prioritized plan you can understand.',
    detail: 'You get a clear roadmap with the work in order of impact, so you know what happens first and why.',
    more: [
      'Fixes sorted by impact and by effort',
      'The topics and pages to build, grouped by what buyers search for',
      'What will be measured, and where the numbers come from',
      'What I need from you and when',
    ],
    output: 'You get a roadmap you can read in a few minutes and agree to before any work starts.',
  },
  {
    n: '04',
    name: 'Build',
    line: 'Build is where the work gets done.',
    detail: 'I make the fixes, write the content, or set up the automation, and keep you updated as I go.',
    more: [
      'Technical fixes, done directly or handed to your developer with clear notes',
      'New and updated pages, written answer-first',
      'Structured data added and tested',
      'Each change noted, so results can be traced back to the work',
    ],
    output: 'You get the finished work, plus a record of what changed and when.',
  },
  {
    n: '05',
    name: 'Measure',
    line: 'Measure means checking the numbers that matter.',
    detail: 'I track rankings, traffic, leads, or hours saved, and report them in plain language.',
    more: [
      'Google Search Console: impressions, clicks, and position',
      'Google Analytics 4: visits and enquiries from search',
      'Featured snippets and AI mentions for the agreed questions',
      'A before and after view against the starting point',
    ],
    output: 'You get a report that says what moved, what did not, and what happens next.',
  },
  {
    n: '06',
    name: 'Iterate',
    line: 'Iterate is the steady improvement after launch.',
    detail: 'Growth is not one and done. We keep refining based on what the data shows.',
    more: [
      'Pages that are close to ranking get improved first',
      'Content that has gone out of date is refreshed',
      'New questions buyers are asking become new pages',
      'Search and AI tools change, so the plan is reviewed, not left alone',
    ],
    output: 'You get an updated plan, so the work keeps pointing at the goal.',
  },
];

const faqs = [
  {
    q: 'How long does a project take?',
    a: 'It depends on the work. A technical SEO audit can be done in a week, while ongoing SEO or content work shows results over a few months. I will give you a realistic timeline before we start.',
  },
  {
    q: 'How often will I hear from you?',
    a: 'I send regular updates and a plain-language report so you always know what is happening and what the results are. You will never have to chase me for a status.',
  },
  {
    q: 'What do you need from me to start?',
    a: 'A short call to understand your goals, and access to the relevant tools, such as your website, Google Search Console, or analytics. I will guide you through anything you are unsure about.',
  },
];
const updated = lastUpdated('process');
---

<BaseLayout
  title={title}
  description={description}
  path="/process.html"
  jsonLd={[
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'Process', path: '/process.html' }]),
    faqPage(faqs),
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Process' }]} />
      <p class="eyebrow">Process</p>
      <h1>How I work, step by step</h1>
      <p class="lead narrow-lead">
        My process is a simple six-step path from first call to steady results. It
        keeps the work clear, so you always know what is happening and why.
      </p>

      <ol class="steps">
        {
          steps.map((s) => (
            <li class="card step">
              <span class="step-n">{s.n}</span>
              <div>
                <h2>{s.name}</h2>
                <p class="step-line">{s.line}</p>
                <p class="muted">{s.detail}</p>
                <ul class="step-more">
                  {s.more.map((m) => <li>{m}</li>)}
                </ul>
                <p class="step-output">{s.output}</p>
              </div>
            </li>
          ))
        }
      </ol>

      {updated && <p class="updated">Last updated: {updated}</p>}
      <a href="/contact.html" class="btn btn-primary">Start with a call</a>
    </div>
  </section>

  <Faq items={faqs} />
</BaseLayout>

<style>
  .narrow-lead {
    max-width: 58ch;
    margin: 0.8rem 0 2rem;
  }
  .steps {
    display: grid;
    gap: 1.1rem;
    counter-reset: step;
  }
  .step {
    display: flex;
    gap: 1.3rem;
    align-items: flex-start;
  }
  .step-n {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    min-width: 2.2rem;
  }
  .step h2 {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .step-line {
    margin-bottom: 0.4rem;
  }
  .step-more {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin: 1rem 0;
  }
  .step-more li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--text-muted);
  }
  .step-more li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .step-output {
    padding-top: 0.9rem;
    border-top: 1px solid var(--border);
    font-weight: 600;
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 2.5rem 0 1.2rem;
  }
</style>
