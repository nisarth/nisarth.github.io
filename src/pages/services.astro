---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import { breadcrumb, faqPage, professionalService, reviews } from '../schema';
import { getCollection } from 'astro:content';
import blogCategories from '../data/blog-categories.json';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { services } from '../data/services';
import { lastUpdated } from '../lib/last-updated';
import Testimonials from '../components/Testimonials.astro';
import { publishedTestimonials, aggregateRating } from '../data/testimonials';

const title = 'Services: SEO, AEO, AI Automation, and Web Development';
const description =
  'SEO, answer engine optimization, AI automation, and web development services from Nisarth Patel, a freelance digital growth specialist in Ahmedabad.';

const groups = [
  {
    name: 'Search visibility',
    line: 'Search visibility is the work of making your business easy to find in Google and in AI answers.',
    items: [
      'Technical SEO audits and fixes',
      'Keyword research and content strategy',
      'On-page and on-site optimization',
      'AEO: FAQ schema and direct-answer content',
      'GEO: content built to be cited by ChatGPT, Perplexity, and AI Overviews',
      'Local SEO and Google Business Profile',
    ],
  },
  {
    name: 'AI automation',
    line: 'AI automation is connecting your tools so routine work runs on its own.',
    items: [
      'n8n, Make, and Zapier workflow builds',
      'AI chatbots for websites and WhatsApp',
      'Lead capture and CRM sync',
      'Automated follow-up and email sequences',
      'Reporting and data automation',
    ],
  },
  {
    name: 'Web development',
    line: 'Web development here means fast, accessible sites that search engines and AI tools can read.',
    items: [
      'Static and modern site builds',
      'Core Web Vitals and speed work',
      'Structured data and clean URLs',
      'Mobile-first, accessible design',
    ],
  },
  {
    name: 'Marketing',
    line: 'Marketing support is the steady work of turning visitors into leads.',
    items: [
      'Content planning and writing',
      'Landing page and conversion work',
      'Email marketing and newsletters',
      'Simple, honest performance reporting',
    ],
  },
];

const allServiceNames = groups.flatMap((g) => g.items);

// Plain symptoms a business owner would recognise, each pointing to one page.
const startHere = [
  {
    problem: 'Your site does not show up in Google',
    answer:
      'The pages may not be crawled or indexed, or they may not match what people search for. A technical SEO audit finds out which.',
    href: '/services/seo.html',
    link: 'SEO services',
  },
  {
    problem: 'You rank, but few people click',
    answer:
      'Google may be answering the question on the results page. AEO shapes your content so your business is the answer shown.',
    href: '/services/aeo.html',
    link: 'AEO services',
  },
  {
    problem: 'AI tools name your competitors, not you',
    answer:
      'ChatGPT, Perplexity, and AI Overviews cite sources they can read and trust. GEO works on being one of them.',
    href: '/services/geo.html',
    link: 'GEO services',
  },
  {
    problem: 'Nearby customers cannot find you on Maps',
    answer:
      'The map pack depends on your Google Business Profile, matching details across the web, and reviews.',
    href: '/services/local-seo.html',
    link: 'Local SEO services',
  },
  {
    problem: 'Your site is slow or hard to update',
    answer:
      'A slow site loses visitors and holds back rankings. A fast, clean build fixes the base everything else stands on.',
    href: '/services/web-development.html',
    link: 'Web development services',
  },
];

// Link the hub into every blog topic, including the two categories
// (digital marketing, e-commerce and SaaS) that have no service page of
// their own and would otherwise be reachable only from the blog index.
const posts = await getCollection('blog');
const topics = blogCategories.map((c) => ({
  ...c,
  label: c.heading.replace(/ Articles$/, ''),
  count: posts.filter((p) => p.data.categorySlug === c.slug).length,
}));

const everyService = [
  'A starting point recorded before work begins, so results can be compared.',
  'Work done in order of impact, biggest problems first.',
  'Plain reports that say what was done, what changed, and what happens next.',
  'Honest limits. Nobody can promise a ranking or a mention in an AI answer.',
  'You keep everything: the content, the accounts, and the access stay yours.',
];

const faqs = [
  {
    q: 'Can I start with just an audit?',
    a: 'Yes. An audit is the most common first step. You get a list of what is holding the site back, in order of importance, and you decide what to do next.',
  },
  {
    q: 'What should I have ready before we start?',
    a: 'Access to your website, Google Search Console, and Google Analytics 4 if you have them, plus a short note on who your customers are and what a good result looks like. If the tools are not set up yet, that becomes the first job.',
  },
  {
    q: 'How do you price your work?',
    a: 'Pricing depends on the scope of the project. Smaller one-off jobs are quoted as a fixed price, and ongoing work is set up as a monthly retainer. Tell me what you need and I will send a clear quote.',
  },
  {
    q: 'Do you offer one-off projects or ongoing work?',
    a: 'Both. Some clients need a single fix, such as a technical SEO audit or an automation build. Others prefer ongoing support each month. I am happy to do either.',
  },
  {
    q: 'Which businesses do you work with?',
    a: 'I work with startups, local businesses, and growing brands, both in India and internationally. Most projects are remote.',
  },
];
const updated = lastUpdated('services');
// Review markup only exists when real, permitted testimonials do.
const reviewSchema = publishedTestimonials.length
  ? [reviews(publishedTestimonials, aggregateRating)]
  : [];
---

<BaseLayout
  title={title}
  description={description}
  path="/services.html"
  jsonLd={[
    professionalService(allServiceNames),
    breadcrumb([{ name: 'Home', path: '/' }, { name: 'Services', path: '/services.html' }]),
    faqPage(faqs),
    ...reviewSchema,
  ]}
>
  <section class="section">
    <div class="container">
      <Breadcrumbs items={[{ name: 'Home', href: '/' }, { name: 'Services' }]} />
      <p class="eyebrow">Services</p>
      <h1>What I can do for your business</h1>
      <p class="lead narrow-lead">
        These are the services I offer as a freelance digital growth specialist. Each
        one is focused on a clear outcome: more visibility, more leads, or less manual
        work.
      </p>

      <div class="service-groups">
        {
          groups.map((g) => (
            <article class="card service-group">
              <h2>{g.name}</h2>
              <p class="group-line">{g.line}</p>
              <ul>
                {g.items.map((i) => <li>{i}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <h2 class="explore-heading">Explore each service in detail</h2>
      <ul class="explore-links">
        {
          services.map((s) => (
            <li>
              <a href={`/services/${s.slug}.html`}>{s.name} services</a>
            </li>
          ))
        }
      </ul>

      <h2>Where to start</h2>
      <p class="muted start-lead">
        Most businesses do not need everything at once. Find the line that sounds like
        you, and that is usually the first job.
      </p>
      <ul class="start-list">
        {
          startHere.map((s) => (
            <li class="card reveal">
              <h3>{s.problem}</h3>
              <p class="muted">{s.answer}</p>
              <a href={s.href}>{s.link}</a>
            </li>
          ))
        }
      </ul>

      <h2>How the services fit together</h2>
      <p>
        SEO is the base. It makes sure search engines can read the site and that each
        page matches a real search. AEO and GEO build on that base: once the pages are
        clear and trusted, they can be shaped so search engines and AI tools quote them.
      </p>
      <p>
        The website carries all of it. A slow or badly built site holds back every other
        effort, which is why speed, structure, and structured data come up in each
        service.
      </p>

      <h2>What every service includes</h2>
      <ul class="include-list">
        {everyService.map((e) => <li class="reveal">{e}</li>)}
      </ul>

      <h2>One-off or ongoing</h2>
      <p>
        Some jobs have a clear end. An audit, a website build, a structured data setup,
        or a Business Profile clean-up can each be done once and handed over.
      </p>
      <p>
        Other work pays off through repetition. Publishing useful content, earning
        links, tracking rankings, and re-checking AI answers all build over months. For
        those, a steady monthly rhythm works better than a single push.
      </p>
      <p>
        Many businesses start with a one-off audit, fix the biggest problems, and only
        then decide whether ongoing work is worth it.
      </p>

      <h2>Not sure what you need?</h2>
      <p>
        That is the usual starting point, and it is fine. Tell me what is going wrong:
        no calls from the website, traffic that dropped, a competitor who shows up
        everywhere. I will look at the site, say what I think the cause is, and suggest
        the smallest first step that would prove it. If the honest answer is that you
        do not need me, I will say that too.
      </p>

      <h2>Free ways to check your own site</h2>
      <p>
        You do not need to hire anyone to find out where you stand. The
        <a href="/seo-audit-checklist.html">SEO audit checklist</a>,
        <a href="/aeo-checklist.html">AEO checklist</a>, and
        <a href="/geo-checklist.html">GEO checklist</a> are free. The
        <a href="/guides.html">guides</a> explain how search works now, and the
        <a href="/glossary.html">glossary</a> explains the terms.
      </p>

      <p class="remote-line">
        I work remote-first with businesses across India and internationally.
      </p>

      <h2>Read up on any of it</h2>
      <p class="muted">
        {posts.length} practical articles, grouped by topic.
      </p>
      <ul class="link-chips">
        {
          topics.map((t) => (
            <li>
              <a href={`/blog/category/${t.slug}.html`}>
                {t.label} ({t.count})
              </a>
            </li>
          ))
        }
      </ul>

      {updated && <p class="updated">Last updated: {updated}</p>}
      <a href="/contact.html" class="btn btn-primary">Get a quote</a>
    </div>
  </section>

  <Testimonials />

  <Faq items={faqs} />
</BaseLayout>

<style>
  .narrow-lead {
    max-width: 60ch;
    margin: 0.8rem 0 0;
  }
  .container > h2 {
    margin: 2.5rem 0 1rem;
  }
  .include-list {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    max-width: 68ch;
  }
  .include-list li {
    position: relative;
    padding-left: 1.5rem;
  }
  .include-list li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .container > p {
    max-width: 68ch;
  }
  .container > p a {
    color: var(--link);
  }
  .start-lead {
    max-width: 60ch;
  }
  .start-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
    margin: 1.5rem 0 0.5rem;
  }
  .start-list h3 {
    font-size: 1.15rem;
    margin-bottom: 0.6rem;
  }
  .start-list a {
    display: inline-block;
    margin-top: 0.9rem;
    font-weight: 600;
    color: var(--accent);
  }
  .start-list a:hover {
    text-decoration: underline;
  }
  .service-groups {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.4rem;
    margin: 2rem 0;
  }
  .service-group h2 {
    font-size: 1.5rem;
    margin-bottom: 0.5rem;
  }
  .group-line {
    color: var(--accent);
    margin-bottom: 1rem;
  }
  .service-group ul {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    color: var(--text-muted);
  }
  .service-group li {
    padding-left: 1.3rem;
    position: relative;
  }
  .service-group li::before {
    content: '+';
    position: absolute;
    left: 0;
    color: var(--accent);
    font-weight: 700;
  }
  .explore-heading {
    margin: 2.5rem 0 1rem;
  }
  .explore-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.5rem;
  }
  .explore-links a {
    color: var(--link);
  }
  .explore-links a:hover {
    color: var(--accent);
  }
  .remote-line {
    margin-top: 1.4rem;
    color: var(--text-muted);
  }
  .link-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }
  .link-chips a {
    display: inline-block;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-elev);
    color: var(--text-muted);
    font-size: 0.9rem;
    transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }
  .link-chips a:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 1.6rem 0 1.2rem;
  }
</style>
