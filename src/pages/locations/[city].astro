---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Map from '../../components/Map.astro';
import { getCollection } from 'astro:content';
import { cities, cityBySlug } from '../../data/cities';
import { services } from '../../data/services';
import { postsForLocation } from '../../data/topic-links';
import { breadcrumb, faqPage, service as serviceSchema } from '../../schema';

export function getStaticPaths() {
  return cities.map((c) => ({ params: { city: c.slug }, props: { record: c } }));
}

const { record } = Astro.props;
const path = `/locations/${record.slug}.html`;
const nearby = record.nearby.map((slug) => cityBySlug(slug)).filter(Boolean);
const guides = postsForLocation(await getCollection('blog'));
---

<BaseLayout
  title={record.title}
  description={record.description}
  path={path}
  jsonLd={[
    serviceSchema({
      name: `SEO and digital marketing in ${record.name}`,
      serviceType: record.primaryKeyword,
      description: record.description,
      url: path,
      areaServed: { '@type': 'City', name: record.name },
    }),
    breadcrumb([
      { name: 'Home', path: '/' },
      { name: 'Locations', path: '/locations.html' },
      { name: record.name, path },
    ]),
    faqPage(record.faqs),
  ]}
>
  <article class="section">
    <div class="container narrow">
      <Breadcrumbs
        items={[
          { name: 'Home', href: '/' },
          { name: 'Locations', href: '/locations.html' },
          { name: record.name },
        ]}
      />

      <p class="eyebrow">{record.name}, {record.region}</p>
      <h1>{record.h1}</h1>
      <p class="lead">{record.definition}</p>

      {record.context.map((p) => <p>{p}</p>)}

      <h2>SEO and digital marketing built for {record.name}</h2>
      <p class="muted">
        Every service below is available to {record.name} businesses, delivered
        remote-first.
      </p>
      <ul class="svc-list">
        {
          services.map((s) => (
            <li class="card">
              <a href={`/services/${s.slug}/${record.slug}.html`} class="svc-name">{s.name} services in {record.name}</a>
              <p class="muted">{s.definition}</p>
            </li>
          ))
        }
      </ul>

      <h2>{record.name} on the map</h2>
      <p class="muted">
        I serve {record.name} remotely. Here is the area I cover.
      </p>
      <Map query={`${record.name}, ${record.region}, ${record.country}`} label={record.name} />

      {
        guides.length > 0 && (
          <>
            <h2>Local search guides</h2>
            <p class="muted">
              Practical reading for any business competing in local search.
            </p>
            <ul class="guide-list">
              {guides.map((g) => (
                <li>
                  <a href={`/blog/${g.id}.html`}>{g.data.title}</a>
                  <span class="guide-meta">{g.data.readingTime}</span>
                </li>
              ))}
            </ul>
          </>
        )
      }

      <h2>Nearby cities</h2>
      <ul class="nearby-links">
        {
          nearby.map((c) => (
            <li>
              <a href={`/locations/${c!.slug}.html`}>SEO in {c!.name}</a>
            </li>
          ))
        }
      </ul>

      <p class="updated">Last updated: June 2026</p>
      <a href="/contact.html" class="btn btn-primary">Grow your {record.name} business</a>
    </div>
  </article>

  <Faq items={record.faqs} heading={`SEO and digital marketing in ${record.name}: FAQs`} />
</BaseLayout>

<style>
  .guide-list {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .guide-list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.7rem;
  }
  .guide-list a {
    color: var(--link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .guide-list a:hover {
    color: var(--accent);
  }
  .guide-meta {
    font-size: 0.82rem;
    color: var(--text-muted);
  }

  h1 {
    margin-bottom: 1rem;
  }
  h2 {
    margin: 2.3rem 0 1rem;
  }
  .lead {
    margin-bottom: 1.2rem;
  }
  article p {
    margin-bottom: 1rem;
  }
  .svc-list {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }
  .svc-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--accent);
    display: inline-block;
    margin-bottom: 0.4rem;
  }
  .svc-list .muted {
    margin: 0;
  }
  .nearby-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.4rem;
  }
  .nearby-links a {
    color: var(--link);
  }
  .nearby-links a:hover {
    color: var(--accent);
  }
  .updated {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
    margin: 2.5rem 0 1.2rem;
  }
</style>
