{
  "name": "nisarth-portfolio",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "npm run gen:dates && astro dev",
    "start": "npm run gen:dates && astro dev",
    "build": "npm run check:dashes && npm run gen:dates && astro build && npm run gen:sitemap && npm run gen:llms",
    "preview": "astro preview",
    "check": "npm run gen:dates && astro check",
    "check:dashes": "node tools/check-no-em-dash.mjs",
    "gen:sitemap": "node tools/gen-sitemap.mjs",
    "gen:icons": "node tools/gen-icons.mjs",
    "gen:og": "node tools/gen-og.mjs",
    "verify": "node tools/verify/jsonld.mjs && node tools/verify/internal-links.mjs && node tools/verify/nav-a11y.mjs && node tools/verify/contact-form.mjs",
    "verify:blog": "node tools/verify/blog-parity.mjs --allow-years-correction --allow-prose-fixes",
    "migrate:blog": "node tools/migrate-blog.mjs",
    "verify:csp": "node tools/verify/csp.mjs",
    "fix:prose": "node tools/fix-blog-prose.mjs",
    "gen:llms": "node tools/gen-llms.mjs",
    "gen:dates": "node tools/gen-last-updated.mjs"
  },
  "dependencies": {
    "astro": "^6.4.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "playwright": "^1.60.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
